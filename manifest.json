{
  "manifest_version": 3,
  "name": "iliasLoginUFR",
  "version": "3.1",
  "description": "Clicks through the Ilias login pages automatically",
  "icons": {
    "48": "icons/48pxIliasLogo.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/16pxiliasLogo.png",
      "32": "icons/32pxiliasLogo.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ilias.uni-freiburg.de/*",
        "*://*.mylogin.uni-freiburg.de/*",
        "*://*.mylogin.ub.uni-freiburg.de/*",
        "*://*.ilias.uni-freiburg.de/ilias.php*"
      ],
      "js": [
        "iliasLogin.js"
      ]
    }
  ],
  "browser_specific_settings": {
  "gecko": {
    "id": "{b7ce2c2a-cd50-4e71-911c-341511630282}",
    "data_collection_permissions": {
      "required": [
        "none"
      ]
    },
    "strict_min_version": "142.0"
  }
}
}